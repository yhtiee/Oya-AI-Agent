# Copy to .env and fill in. Validated at boot by src/server/env.ts (SPEC §21.3).
# Never commit real values. Server-only secrets must not start with NEXT_PUBLIC_.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role / secret key. Server only. Needed by /api/health and feature flags; required in production.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL for the CLI (migrations). Not used by the running app.
DATABASE_URL=
# Signs Supabase-compatible access tokens for Oya sessions (docs/decisions.md D-010).
# Generate with: pnpm exec tsx scripts/generate-jwt-signing-key.ts, then import into Supabase.
SUPABASE_JWT_SIGNING_KEY=
# 32 random bytes, base64. Encrypts ops two-factor secrets. Required in production.
APP_ENCRYPTION_KEY=

# --- Site ---
# Public address for share previews, sitemap and canonical links, e.g. https://oya.ng
NEXT_PUBLIC_SITE_URL=
APP_BASE_URL=

# --- Mode ---
# mock (default) or live. Integrations use their mock until this is live.
INTEGRATIONS_MODE=mock
# Mirrors the bootstrap_mode feature flag (SPEC §20.1). Leave blank to use the flag.
BOOTSTRAP_MODE=

# --- Monitoring (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Later milestones (declared now, validated when set) ---
# M2 jobs: APP_ENCRYPTION_KEY (32+ chars), OYA_CRON_SECRET (24+ chars), CRON_SECRET
# M3 LLM: GOOGLE_GENERATIVE_AI_API_KEY (bootstrap primary), ANTHROPIC_API_KEY, LLM_* models, LLM_DAILY_BUDGET_USD
# M4 push: VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
# M6+ WhatsApp, Termii, Paystack, Maps, speech, ID verification: see SPEC §21.3

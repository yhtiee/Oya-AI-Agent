{
  "name": "oya-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:grants": "tsx scripts/check-migration-grants.ts",
    "db:push": "npx supabase db push --linked",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/types/db.ts",
    "eval": "tsx scripts/eval.ts",
    "check:llm-routing": "tsx scripts/check-llm-routing.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/google": "4.0.124",
    "@ai-sdk/groq": "4.0.86",
    "@radix-ui/react-slot": "1.5.0",
    "@sentry/nextjs": "11.16.0",
    "@supabase/supabase-js": "2.119.2",
    "ai": "7.0.179",
    "chrono-node": "2.10.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "libphonenumber-js": "1.13.17",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rrule": "2.8.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}

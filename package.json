{
  "name": "oya-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:grants": "tsx scripts/check-migration-grants.ts",
    "db:push": "npx supabase db push --linked",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/types/db.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.4.0",
    "@sentry/nextjs": "11.5.0",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "libphonenumber-js": "1.13.14",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
